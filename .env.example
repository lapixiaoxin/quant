# 复制为 .env 后按需修改。所有变量以 QT_ 前缀。

# ---- 路径 ----
QT_DATA_DIR=data
QT_REPORTS_DIR=reports

# ---- 回测默认参数 ----
QT_INITIAL_CASH=1000000
# 资产类型：stock=个股 / etf=基金（ETF 免印花税与过户费，且最小变动价位为 0.001）
QT_ASSET_TYPE=stock

# 股票费率（A 股）
QT_COMMISSION_RATE=0.0003
# 印花税千 0.5，仅卖出单边；2023-08-28 起由 0.1% 减半征收
QT_STAMP_TAX_RATE=0.0005
# 过户费十万分之一，双向
QT_TRANSFER_FEE_RATE=0.00001
QT_MIN_COMMISSION=5.0

# ETF 费率（免印花税、免过户费）
QT_ETF_COMMISSION_RATE=0.0003
QT_ETF_MIN_COMMISSION=5.0

QT_SLIPPAGE=0.0002
QT_VOLUME_LIMIT_PCT=0.2
QT_T_PLUS_ONE=true
# 可选：使用引擎内置费率模板（cn_stock_miniqmt / cn_stock_t1_low_fee / cn_stock_sim_high_slippage）
QT_BROKER_PROFILE=

# ---- 实盘/仿真 ----
# paper=本地回放模拟；broker_live=真实柜台
QT_LIVE_TRADING_MODE=paper
# 行情/交易通道，需成对指定；留空则用内部 replay(行情)+miniqmt(交易) 仿真
QT_LIVE_MARKET_BROKER=replay
QT_LIVE_TRADER_BROKER=miniqmt
# 真实柜台连接参数（CTP 示例，按需填写）
QT_MD_FRONT=
QT_TD_FRONT=
QT_BROKER_ID=
QT_USER_ID=
QT_PASSWORD=
QT_APP_ID=
QT_AUTH_CODE=
